CREATE EXTENSION IF NOT EXISTS pgcrypto WITH SCHEMA extensions;

CREATE OR REPLACE FUNCTION public.recover_account(_code text, _new_password text)
RETURNS text
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public, extensions
AS $$
DECLARE
  target uuid;
  uname text;
BEGIN
  IF _code IS NULL OR length(trim(_code)) < 8 THEN
    RAISE EXCEPTION 'Invalid recovery code';
  END IF;
  IF _new_password IS NULL OR length(_new_password) < 6 THEN
    RAISE EXCEPTION 'New password must be at least 6 characters';
  END IF;

  SELECT id, username INTO target, uname
  FROM public.profiles WHERE recovery_code = trim(_code) LIMIT 1;

  IF target IS NULL THEN
    RAISE EXCEPTION 'Invalid recovery code';
  END IF;

  UPDATE auth.users
    SET encrypted_password = extensions.crypt(_new_password, extensions.gen_salt('bf')),
        updated_at = now()
    WHERE id = target;

  RETURN uname;
END;
$$;

REVOKE EXECUTE ON FUNCTION public.recover_account(text, text) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.recover_account(text, text) TO anon, authenticated;